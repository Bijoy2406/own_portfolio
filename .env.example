# ─── Secrets & config (server-side only — NEVER hardcode values in source) ──
#
# This file is a TEMPLATE for local development. The real values live in
# Netlify's runtime env (Site settings → Environment variables). Netlify's
# secret scanner compares each env var's value against the repo + build
# output, so duplicating those values anywhere in source fails the deploy.
# Keep this template free of any real value.

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@example.com
# Destination address for contact-form submissions. Renamed from
# RESEND_TO_EMAIL → CONTACT_INBOX so Netlify doesn't scan the personal email
# against public source strings (index.html schema.org + portfolioData.ts
# PERSONAL_INFO.contact.email). Set CONTACT_INBOX to a Gmail +tag alias
# (e.g. you+portfolio@gmail.com) so messages still arrive in your main inbox.
CONTACT_INBOX=

# OpenAI / OpenAI-compatible LLM (server-side only)
OPENAI_API_KEY=
# Custom base URL when using a non-OpenAI provider (Groq, OpenRouter,
# NaraRouter, etc.). Read at runtime — never hardcode the real value.
OPENAI_BASE_URL=
# Default model id used when the visitor doesn't pick one from the
# dropdown. Same rule — the real id must not be duplicated in source.
OPENAI_MODEL=

# (Optional) GitHub token (Classic or Fine-grained PAT). Increases GitHub
# API rate limit for repo visibility checks. Server-side only.
GITHUB_TOKEN=

# (Optional) Comma-separated list of free-tier model ids that the
# /api/models endpoint advertises. Read by netlify/functions/models.ts at
# runtime. Update this list whenever your provider rotates the free tier.
#
# IMPORTANT: the value you set here must not appear anywhere else in the
# repo or build output. Set it in this file (and matching Netlify env var)
# only — never as a literal in TypeScript.
OPENAI_FREE_TIER_IDS=
