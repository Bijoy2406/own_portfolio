# ─── Secrets (server-side only — DO NOT hardcode these values in source) ──
#
# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@example.com
# RESEND_TO_EMAIL is the destination address for contact-form submissions.
# IMPORTANT: its VALUE must not appear as a literal anywhere in the repo or
# build output. The personal email is publicly listed in
# src/data/portfolioData.ts and index.html — to keep Netlify's
# secret-scanner happy, set RESEND_TO_EMAIL to a different alias here
# (e.g. a Gmail +tag alias like you+portfolio@gmail.com that Gmail forwards
# to your main inbox).
RESEND_TO_EMAIL=

# OpenAI / OpenAI-compatible LLM (server-side only)
OPENAI_API_KEY=
# Custom base URL when using a non-OpenAI provider (Groq, OpenRouter,
# NaraRouter, etc.). The value is read at runtime and is never hardcoded in
# source.
OPENAI_BASE_URL=
# Default model id used when the visitor doesn't pick one from the
# dropdown. Same rule as OPENAI_BASE_URL — value must not be duplicated in
# source.
OPENAI_MODEL=

# (Optional) GitHub token (Classic or Fine-grained PAT). Increases GitHub
# API rate limit for repo visibility checks. Server-side only.
GITHUB_TOKEN=

# (Optional) Comma-separated list of free-tier model ids that the
# /api/models endpoint advertises in the visitor's dropdown. Read by
# netlify/functions/models.ts at runtime. Update this list whenever your
# provider rotates the free tier — duplicating these ids in source is what
# triggered the previous secret-scan failure.
#
# Example for NaraRouter's current free plan:
# OPENAI_FREE_TIER_IDS=space-bunny-alpha,space-bunny-alpha-bynara,laguna-s-2.1,ling-3.0-flash-fin-free,ling-3.0-flash-sante-free,ling-3.0-flash-vl-free,nemotron-3-super-free,nemotron-3-ultra-free,nemotron-3.5-lightning-free,nex-n2.5-pro,agnes-2.5-flash
OPENAI_FREE_TIER_IDS=
