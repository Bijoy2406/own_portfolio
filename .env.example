# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=

# The email address to send FROM.
# Since you have verified your custom domain on Resend, you can use:
# contact@yourdomain.com or hello@yourdomain.com
# If testing without a domain, you can temporarily use: onboarding@resend.dev
RESEND_FROM_EMAIL=

# The email address where you want to receive messages:
RESEND_TO_EMAIL=

# OpenAI / Compatible LLM Configuration
OPENAI_API_KEY=
# (Optional) Custom base URL if using Groq, DeepSeek, OpenRouter, etc.
# Example for Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# (Optional) Model name to use (e.g. gpt-4o-mini, llama-3.3-70b-versatile, deepseek-chat)
# Defaults to gpt-4o-mini if not set
OPENAI_MODEL=

# (Optional) GitHub Token (Classic or Fine-grained PAT)
# Increases GitHub API rate limit from 60/hour to 5,000/hour for repo visibility checking
GITHUB_TOKEN=
